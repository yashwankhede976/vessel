# Vessel backend — environment variable template.
# Copy this file to backend/.env and fill in real values locally.
# NEVER commit real secrets. backend/.env is git-ignored; this template is committed.
# See docs/DEVELOPMENT_WORKFLOW.md §12 and docs/ENVIRONMENT.md.
#
# Legend:  [MANDATORY(prod)] must be set in production
#          [OPTIONAL]        has a safe default or feature is optional
#
# =============================================================================
# Core Django
# =============================================================================

# Which environment this process runs as: development | testing | production
DJANGO_ENV=development

# [MANDATORY(prod)] Django cryptographic secret. Generate a strong random value.
# A dev-only fallback is used ONLY when DJANGO_ENV=development. Production refuses
# to start without a real value (see config/env_validation.py).
# Accepts SECRET_KEY or DJANGO_SECRET_KEY (SECRET_KEY takes precedence).
SECRET_KEY=changeme-generate-a-strong-key

# [OPTIONAL] Debug mode. MUST be false in production (startup validation enforces this).
# Accepts DEBUG or DJANGO_DEBUG (DEBUG takes precedence).
DEBUG=true

# [MANDATORY(prod)] Comma-separated hosts Django will serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# Database
# =============================================================================

# [MANDATORY(prod)] Database connection URL.
# If unset, the backend uses local SQLite so it starts with no external services.
# Production MUST set a PostgreSQL/PostGIS URL (startup validation enforces this).
#   PostgreSQL:  postgres://USER:PASSWORD@HOST:5432/DBNAME
#   PostGIS:     postgis://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=postgres://vessel:changeme@localhost:5432/vessel

# =============================================================================
# CORS (the separately deployed frontend origin[s] allowed to call this API)
# =============================================================================

# [OPTIONAL] Comma-separated list of allowed origins. Defaults to the local Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# =============================================================================
# External data provider API keys
# (see docs/DATA_SOURCES.md — do NOT implement clients here)
# =============================================================================

# [OPTIONAL] AISStream (vessel tracking / AIS WebSocket). Free, registration required.
# Without this key, AIS ingestion is disabled and the platform degrades gracefully.
AISSTREAM_API_KEY=

# [OPTIONAL] UN Comtrade (trade flows). Free public tier; a key raises rate limits.
# Accepts COMTRADE_API_KEY or UN_COMTRADE_API_KEY.
COMTRADE_API_KEY=

# [OPTIONAL] data.gov.in (Indian open government data). Free API key.
# Accepts DATA_GOV_API_KEY or DATA_GOV_IN_API_KEY.
DATA_GOV_API_KEY=

# [OPTIONAL] Open-Meteo (weather). Works WITHOUT a key on the free tier.
# Set only if you use a commercial/self-hosted endpoint or key.
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# OPEN_METEO_API_KEY=

# [OPTIONAL] IMD (India Meteorological Department) configuration, if used.
# No standard public API key; configure a base URL / product endpoint if applicable.
# IMD_BASE_URL=

# [LICENSED] Baltic Exchange (freight benchmark) — commercial/licensed. Do NOT commit.
# Leave unset for the prototype (uses a public proxy / labelled synthetic data).
# BALTIC_EXCHANGE_API_KEY=

# [OPTIONAL, KEYLESS] INCOIS (ocean-state) — public products; no key.
# Optional base-URL override only; product URLs are supplied per ingestion config.
# INCOIS_BASE_URL=

# [OPTIONAL, KEYLESS] World Bank Indicators API v2 — public; no key.
# WORLD_BANK_BASE_URL=https://api.worldbank.org/v2

# =============================================================================
# OpenAI (AI chatbot) — BACKEND ONLY. NEVER expose this to the frontend.
# =============================================================================
# [OPTIONAL] OpenAI API key for the AI chatbot (POST /api/v1/chat/).
# If UNSET, the chatbot still works: it falls back to a deterministic, grounded
# rule-based answer built from the platform's own engines (no external call).
# NEVER commit a real key. Put your real key only in backend/.env (git-ignored).
# This key is read only on the Django backend and is never sent to React or logged.
OPENAI_API_KEY=

# [OPTIONAL] Model + limits (safe defaults if unset).
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=20
# OPENAI_MAX_OUTPUT_TOKENS=600

# ---- Raw / processed data retention (see docs/DATA_INGESTION_ARCHITECTURE.md) ----
# DATA_DIR defaults to <repo>/data. Raw retention is OPT-IN (off by default).
# DATA_DIR=
# INGESTION_SAVE_RAW=false
