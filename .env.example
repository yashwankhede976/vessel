# Vessel — root environment variable template (convenience fallback).
#
# PREFER the per-service templates:
#   backend/.env.example   -> copy to backend/.env
#   frontend/.env.example  -> copy to frontend/.env
#
# The backend reads backend/.env first, then this repo-root .env as a fallback.
# Copy to .env and fill in real values locally. NEVER commit real secrets.
# .env is git-ignored; this .env.example (placeholders only) is committed.
# Full reference: docs/ENVIRONMENT.md

# ---- Django (backend) ----
DJANGO_ENV=development                       # development | testing | production
SECRET_KEY=changeme-generate-a-strong-key    # mandatory in production
DEBUG=true                                   # must be false in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1     # real host(s) in production

# ---- Database ----
# Unset uses local SQLite. Production MUST set a PostgreSQL/PostGIS URL.
# DATABASE_URL=postgres://vessel:changeme@localhost:5432/vessel

# Used by docker-compose for the Postgres/PostGIS service.
POSTGRES_DB=vessel
POSTGRES_USER=vessel
POSTGRES_PASSWORD=changeme

# ---- CORS (frontend origin allowed to call the API) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- External data provider keys (all optional; see docs/DATA_SOURCES.md) ----
AISSTREAM_API_KEY=
COMTRADE_API_KEY=
DATA_GOV_API_KEY=
# OpenAI API key for the AI chatbot — BACKEND ONLY, never exposed to React.
# Optional: if unset the chatbot falls back to a grounded rule-based answer.
# NEVER commit a real key; put it only in a git-ignored .env / .env.local.
OPENAI_API_KEY=
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1   # works without a key
# OPEN_METEO_API_KEY=
# IMD_BASE_URL=
# BALTIC_EXCHANGE_API_KEY=   # licensed/commercial — do not commit

# ---- Frontend (public; baked into the build) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAP_PROVIDER=maplibre                   # maplibre (no key) | maptiler | mapbox
# INCOIS (ocean-state) and World Bank (indicators) are KEYLESS — no key needed.
# INCOIS_BASE_URL=
# WORLD_BANK_BASE_URL=https://api.worldbank.org/v2
# DATA_DIR=            # defaults to <repo>/data
# INGESTION_SAVE_RAW=false   # opt-in raw provider-response retention
