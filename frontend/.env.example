# Vessel frontend — environment variable template.
# Copy this file to frontend/.env and fill in values locally.
# NEVER commit real secrets. frontend/.env is git-ignored; this template is committed.
#
# IMPORTANT: Vite inlines any variable prefixed with VITE_ into the client bundle
# at BUILD time. Anything here is PUBLIC — never put secrets or private API keys
# in frontend env. Secret provider keys belong ONLY in the backend.
#
# Legend:  [MANDATORY(prod)] must be set for a production build
#          [OPTIONAL]        has a safe default
#
# =============================================================================
# Backend API
# =============================================================================

# [MANDATORY(prod)] Base URL of the backend API. Baked into the build.
# Local dev default points at the local Django server.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# =============================================================================
# Map provider (client-side map rendering)
# =============================================================================

# [OPTIONAL] Map provider selection: maplibre (default, no key) | maptiler | mapbox
# MapLibre with a free/open style needs no key. Commercial providers need a public
# access token (still public — restrict it by URL/domain in the provider console).
VITE_MAP_PROVIDER=maplibre

# [OPTIONAL] Public style URL for the map (MapLibre style JSON / provider style).
# VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# [OPTIONAL] Public map token/key IF using a commercial provider (maptiler/mapbox).
# This is a PUBLIC, domain-restricted token — not a secret.
# VITE_MAP_API_KEY=
